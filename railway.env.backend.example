# Backend Service Environment Variables
# This file is used by scripts/sync-railway-env.sh to sync variables to Railway
# DO NOT commit actual API keys - use Railway dashboard or Railway CLI secrets

DATABASE_URL=sqlite:////app/data/db/heromaker.db
DEBUG=false
FILES_ROOT=/app/data/files
OPENAI_API_KEY=your_openai_api_key_here
MESHY_API_KEY=your_meshy_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_MODEL_FALLBACK=
ALLOWED_ORIGINS=https://heromaker.up.railway.app
VRM_CONVERTER_SERVICE_URL=http://vrm-converter:8000
VRM_CONVERTER_TIMEOUT=300

