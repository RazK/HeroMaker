# Development Dockerfile for Frontend - Hot reload with Vite
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy configuration files
COPY vite.config.ts .
COPY tsconfig.json .
COPY tsconfig.node.json .
COPY index.html .

# Expose Vite dev server port
EXPOSE 3000

# Start Vite dev server
CMD ["npm", "run", "dev"]


