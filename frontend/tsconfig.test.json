{
  // Unit tests for plain-logic modules (no React, no three.js): compiled to
  // .test-build and run by Node's own test runner. `npm test`.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": ".test-build"
  },
  "include": ["src/**/*.test.ts"]
}
