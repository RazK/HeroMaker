*.tsbuildinfo

# Database
*.db
*.sqlite
*.sqlite3
heromaker.db

# Railway environment variables: the layered *.env files under
# devops/railway/env/ ARE tracked (they hold no secrets — see the README
# there). Only the secret layers stay local.
devops/railway/env/secrets.env
devops/railway/env/secrets.*.env

# Pre-layering env files, ignored so an old checkout cannot commit its keys
devops/railway/env/backend
devops/railway/env/frontend
devops/railway/env/vrm-converter

# Environment files
.env
.env.railway
*.mov

# Data directory (excluded from git to speed up Railway snapshots)
data/
frontend/dev-dist/
