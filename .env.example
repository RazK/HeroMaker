# HeroMaker Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and should not be committed

# =============================================================================
# External API Keys
# =============================================================================

# OpenAI API Key (required for ChatGPT image rendering and naming)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Meshy API Key (required for 3D model generation)
# Get your key from: https://www.meshy.ai/
MESHY_API_KEY=your_meshy_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================

# Database URL
# For SQLite (default): sqlite:///./heromaker.db
# For PostgreSQL: postgresql://user:password@postgres:5432/heromaker
# Note: In Docker, use relative path like ./heromaker.db (will be in /app directory)
DATABASE_URL=sqlite:///./heromaker.db

# =============================================================================
# Application Configuration
# =============================================================================

# Debug mode (true/false)
# Set to true for development, false for production
DEBUG=false

# Assets root directory
# In Docker containers, this should be /app/assets (mounted from ./assets)
# For local development, use ./assets or ../assets
ASSETS_ROOT=/app/assets

# =============================================================================
# OpenAI Image Model Configuration
# =============================================================================

# Primary model for image editing (must support images.edit())
OPENAI_IMAGE_MODEL=gpt-image-1

# Fallback model (optional, set to a model name if available)
# Note: gpt-image-1-mini does NOT support images.edit()
OPENAI_IMAGE_MODEL_FALLBACK=

# =============================================================================
# VRM Converter Service Configuration
# =============================================================================

# VRM Converter Service URL
# In docker-compose, use service name: http://vrm-converter:8000
# For standalone: http://localhost:8002 (host) or http://localhost:8000 (container)
VRM_CONVERTER_SERVICE_URL=http://vrm-converter:8000

# VRM Converter timeout in seconds (default: 300 = 5 minutes)
VRM_CONVERTER_TIMEOUT=300

# =============================================================================
# Frontend Configuration
# =============================================================================

# Frontend API Base URL
# Leave empty for same-origin (when frontend proxies to backend)
# Or set to full backend URL for remote deployments
# Example: http://localhost:8000 or https://api.yourdomain.com
VITE_API_BASE_URL=

# =============================================================================
# VRM Converter Service Version (for docker-compose)
# =============================================================================

VRM_CONVERTER_VERSION=1.0.0
