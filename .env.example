# HeroMaker Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# API Keys (REQUIRED)
# ============================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Get your Meshy API key from: https://meshy.ai/
MESHY_API_KEY=meshy_...

# ============================================
# Database Configuration
# ============================================
# SQLite database (default for development)
# For PostgreSQL, use: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./heromaker.db

# ============================================
# Application Settings
# ============================================
# Debug mode (true/false)
# Set to true for development, false for production
DEBUG=false

# Assets root directory
# In Docker, this is /app/assets (mounted from ./assets)
# For local development, use relative path: ./assets
ASSETS_ROOT=./assets

# ============================================
# OpenAI Image Model Configuration
# ============================================
# Primary model for image editing (must support images.edit())
OPENAI_IMAGE_MODEL=gpt-image-1

# Fallback model to try if primary model fails
# Note: gpt-image-1-mini does NOT support images.edit()
# Leave empty to disable fallback
OPENAI_IMAGE_MODEL_FALLBACK=

# ============================================
# Blender Configuration (for VRM conversion)
# ============================================
# Blender executable path
# In Docker, this is set automatically: /usr/local/bin/blender
# For local development, set to your Blender installation path
# Examples:
#   - macOS: /Applications/Blender.app/Contents/MacOS/Blender
#   - Linux: /usr/bin/blender
#   - Windows: C:\Program Files\Blender Foundation\Blender\blender.exe
BLENDER_PATH=/usr/local/bin/blender
