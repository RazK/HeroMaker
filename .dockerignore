# Git
.git
.gitignore

# Documentation
docs
*.md
README.md

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs

# Database
*.db
*.sqlite
*.sqlite3

# Assets (mounted as volume)
assets/

# Node modules, at any depth: the frontend image builds from the repo root
# (it bundles games/hero-moves), and a host-built node_modules copied over
# the image's own `npm ci` would break it.
node_modules/
**/node_modules/

# Python
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
env/

# Build outputs
dist/
**/dist/
build/
*.egg-info/
