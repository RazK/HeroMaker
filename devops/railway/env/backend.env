# backend, both environments.
#
# Values that genuinely differ per environment are NOT here — they are Railway
# references, resolved by Railway inside whichever environment is deploying:
#   ${{shared.X}}          -> the project's shared variable X for that environment
#   ${{Postgres.X}}        -> variable X exported by the Postgres service
#   ${{frontend.X}}        -> variable X exported by the frontend service
# That is why this file has no staging/production twin to keep in sync.

# --- Storage ------------------------------------------------------------
# Railway's Postgres plugin exports DATABASE_URL per environment, so staging
# points at the staging database and production at the production one with
# one line. Rename `Postgres` if the database service is named differently.
DATABASE_URL=${{Postgres.DATABASE_URL}}

S3_BUCKET=${{shared.S3_BUCKET}}
S3_ENDPOINT=https://storage.railway.app
S3_REGION=auto
S3_ACCESS_KEY_ID=${{shared.S3_ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{shared.S3_SECRET_ACCESS_KEY}}

# Only read when S3_BUCKET is unset (volume-backed deployments).
FILES_ROOT=/app/data/files

# --- External APIs ------------------------------------------------------
OPENAI_API_KEY=${{shared.OPENAI_API_KEY}}
MESHY_API_KEY=${{shared.MESHY_API_KEY}}
OPENAI_IMAGE_MODEL=gpt-image-1
# gpt-image-1-mini does NOT support images.edit(), so it cannot be a fallback.
# OPENAI_IMAGE_MODEL_FALLBACK=

# --- Auth ---------------------------------------------------------------
# A different secret per environment, declared once: the shared variable is
# what differs, not this file.
JWT_SECRET_KEY=${{shared.JWT_SECRET_KEY}}
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Service wiring -----------------------------------------------------
# Resolves to this environment's own frontend domain, so staging allows the
# staging origin and production the production one.
ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# The converter's Dockerfile CMD pins uvicorn to 8000, so the port is fixed
# rather than Railway's dynamic $PORT. This is the value both environments
# already run with; `railway-env.sh diff` will tell you if that drifted.
VRM_CONVERTER_SERVICE_URL=http://vrm-converter.railway.internal:8000
VRM_CONVERTER_TIMEOUT=300
