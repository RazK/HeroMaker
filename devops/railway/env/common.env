# Shared by EVERY service in EVERY environment.
#
# Anything written here is set once and applied to backend, frontend and
# vrm-converter, in both staging and production. If a value is the same in
# staging and production, it belongs in a layer like this one — never copied
# into both <service>.staging.env and <service>.production.env.
#
# Layer order (later wins):
#   common.env -> common.<env>.env -> <service>.env -> <service>.<env>.env
#   -> secrets.env -> secrets.<env>.env   (the last two are gitignored)

# Staging deliberately mirrors production here: a staging box that runs with
# DEBUG=true does not test what production actually does.
DEBUG=false
