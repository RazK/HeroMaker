# backend, staging ONLY.
#
# Keep this file as close to empty as you can. A line here is a line that has
# to be kept in sync with its twin in backend.production.env forever.
#
# Before adding one, check whether the value can instead be:
#   - identical in both environments  -> put it in backend.env
#   - identical for every service     -> put it in common.env
#   - a Railway reference that resolves per environment on its own
#     (${{shared.X}}, ${{Postgres.X}}, ${{backend.RAILWAY_PUBLIC_DOMAIN}})
#   - a secret                        -> a Railway shared variable, referenced
#                                        as ${{shared.X}} from backend.env
#
# Legitimate residents: things that are structurally different between the two
# environments and cannot be expressed as a reference. Setting KEY= (empty)
# stops a key inherited from a lower layer being pushed.

# Staging result cache for the paid pipeline steps (openai_render, meshy_3d,
# meshy_rig). The staging robot uploads the same drawing every run; with this
# on, only the first run pays OpenAI and Meshy and later runs copy the stored
# outputs. Users are still charged credits as normal. Keyed on the input bytes
# plus the prompt/parameters, so changing either misses. Production must NEVER
# have it - which is why it lives here, and why the backend also ignores it in
# a Railway environment named "production". See backend/app/services/result_cache.py.
PIPELINE_RESULT_CACHE=1
