# backend, staging ONLY.
#
# Keep this file as close to empty as you can. A line here is a line that has
# to be kept in sync with its twin in backend.production.env forever.
#
# Before adding one, check whether the value can instead be:
#   - identical in both environments  -> put it in backend.env
#   - identical for every service     -> put it in common.env
#   - a Railway reference that resolves per environment on its own
#     (${{shared.X}}, ${{Postgres.X}}, ${{backend.RAILWAY_PUBLIC_DOMAIN}})
#   - a secret                        -> a Railway shared variable, referenced
#                                        as ${{shared.X}} from backend.env
#
# Legitimate residents: things that are structurally different between the two
# environments and cannot be expressed as a reference. Setting KEY= (empty)
# stops a key inherited from a lower layer being pushed.

# Staging result cache for the paid pipeline steps (openai_render, meshy_3d,
# meshy_rig). The staging robot uploads the same drawing every run; with this
# on, only the first run pays OpenAI and Meshy and later runs copy the stored
# outputs. Users are still charged credits as normal. Keyed on the input bytes
# plus the prompt/parameters, so changing either misses. Production must NEVER
# have it - which is why it lives here, and why the backend also ignores it in
# a Railway environment named "production". See backend/app/services/result_cache.py.
PIPELINE_RESULT_CACHE=1

# Analytics (docs/analytics/REQUIREMENTS.md): record what visitors do, with no
# personal data. Staging ONLY for now, and off everywhere it is not set: the
# privacy policy Raz approved says "No analytics, ads or tracking", and only
# he changes its words. When the policy says what is collected, move this line
# to backend.env so production records too. See backend/app/services/analytics.py.
ANALYTICS_ENABLED=true

# Pay after the reveal (E-006, backend/app/services/free_painting.py): an
# account that has never bought may make its first painting with no credits;
# the hero then pauses before 3D until paid. Staging ONLY, the PM's call for
# the Sprint 1 demo (2026-11-23). Production stays off: turning it on for real
# customers gives a painting (~$0.17) to everyone and is Raz's decision.
FREE_PAINTING=1

# Payments: the REAL Grow provider (backend/app/services/grow.py), staging
# ONLY, pointed at the Grow stand-in (backend/app/api/grow_standin.py) until
# Grow issues HeroMaker's sandbox userId and pageCode. Then GROW_API_BASE
# becomes https://sandbox.meshulam.co.il, GROW_USER_ID / GROW_PAGE_CODE become
# Grow's, and GROW_STANDIN_ENABLED goes. The stand-in refuses to run in a
# Railway environment named "production" whatever this says. GROW_NOTIFY_SECRET
# signs each order's notifyUrl. On staging it reuses the sandbox's own test
# secret (already a Railway variable here, never committed); production gets
# its own shared variable when Raz says yes.
PAYMENTS_PROVIDER=grow
GROW_API_BASE=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}/api/payments/grow-standin
GROW_USER_ID=standin
GROW_PAGE_CODE=standin
GROW_STANDIN_ENABLED=1
GROW_NOTIFY_SECRET=${{GROW_SANDBOX_SECRET}}
