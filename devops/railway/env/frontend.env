# frontend, both environments.
#
# Baked into the bundle at build time, so the frontend must be redeployed
# after this changes.
#
# ${{backend.RAILWAY_PUBLIC_DOMAIN}} is resolved by Railway per environment:
# the staging frontend gets the staging backend, production gets production,
# without this line existing twice.
VITE_API_BASE_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
