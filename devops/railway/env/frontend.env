# frontend, both environments.
#
# Baked into the bundle at build time, so the frontend must be redeployed
# after this changes.
#
# ${{backend.RAILWAY_PUBLIC_DOMAIN}} is resolved by Railway per environment:
# the staging frontend gets the staging backend, production gets production,
# without this line existing twice.
VITE_API_BASE_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# Where nginx sends /api/ (frontend/start-nginx.sh). The 3D files and every
# thumbnail URL are relative (/api/files/...), so they all go through this.
# The backend's PUBLIC domain, as staging always had: production pointed at
# http://backend.railway.internal:8080, the private network, and every
# proxied request failed (502 / 504), so no hero's 3D loaded on production.
# Read at container start, not build time: a restart picks up a change.
VITE_API_PROXY_TARGET=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
