# frontend, both environments.
#
# Baked into the bundle at build time, so the frontend must be redeployed
# after this changes.
#
# ${{backend.RAILWAY_PUBLIC_DOMAIN}} is resolved by Railway per environment:
# the staging frontend gets the staging backend, production gets production,
# without this line existing twice.
VITE_API_BASE_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}

# nginx's /api fallback. The SPA does not use it - VITE_API_BASE_URL sends it
# straight to the backend's public domain - but without this the fallback
# points at the docker-compose default (http://backend:8000), which on Railway
# resolves to nothing and hangs for 20s before a 504. Set it so the path is
# either correct or obviously absent, never quietly broken.
VITE_API_PROXY_TARGET=http://backend.railway.internal:8080
